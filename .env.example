# Convex
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Sentry (Phase 0: leave blank to disable; populate before deploy)
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog (analytics). Leave BLANK to disable: with no key, posthog-js is never
# imported and no request is made.
# Setting a key here does NOT make local dev track. Analytics also requires the
# production hostname (kodapos.app), so `pnpm dev` on localhost and Cloudflare
# preview deployments stay inert even with a key present. To change which hosts
# count as production, edit TRACKED_HOSTS in src/lib/analytics/policy.ts.
# The privacy policy must disclose PostHog as a processor before this is
# enabled for real users. See
# docs/superpowers/specs/2026-07-23-posthog-analytics-design.md
VITE_POSTHOG_KEY=
# Ingestion defaults to the first-party /relay proxy in code (client.ts); this
# is an override only, for pointing a build at a different host. Setting it
# here (or in the Cloudflare dashboard) reintroduces the direct
# us.i.posthog.com request the proxy exists to avoid, so leave it unset.
# VITE_POSTHOG_HOST=

# Cloudflare Pages (populated by `wrangler login`)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
